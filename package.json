{
	"name": "viva",
	"version": "1.1.2",
	"description": "Benchmark data analysis for optimization solvers.",
	"main": "",
	"scripts": {
		"test": "jest",
		"test:functions": "jest Function.test.ts DataProcessing.test.ts UserConfiguration.test.ts Pages.test.ts ChartData.test.ts Parsers.test.ts",
		"test:ui": "jest UI.test.ts Offline.test.ts ChartPages.test.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"start": "webpack serve --config webpack.config.js",
		"build": "webpack --config webpack.config.js && node scripts/build-service-worker.mjs",
		"build:docs": "typedoc --options typedoc.json",
		"build:pages": "node scripts/build-pages.mjs",
		"check:pages": "node scripts/build-pages.mjs --check",
		"check:sw": "node scripts/build-service-worker.mjs --check",
		"release": "gulp release",
		"release:web": "gulp release-web"
	},
	"pre-commit": [
		"test:functions",
		"lint:fix"
	],
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node"
	},
