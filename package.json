{
	"name": "viva",
	"version": "1.2.0",
	"private": true,
	"description": "Benchmark data analysis for optimization solvers.",
	"scripts": {
		"test": "jest",
		"test:functions": "jest",
		"test:coverage": "jest --coverage",
		"typecheck": "tsc --noEmit",
		"test:ui": "playwright test --project=chromium",
		"test:ui:update": "playwright test --project=chromium --update-snapshots",
		"test:visual": "playwright test --project=visual",
		"test:visual:update": "playwright test --project=visual --update-snapshots",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"start": "webpack serve --config webpack.config.js",
		"build": "webpack --config webpack.config.js && node scripts/build-service-worker.mjs",
		"build:docs": "node scripts/clean-docs.mjs && typedoc --options typedoc.json",
		"build:pages": "node scripts/build-pages.mjs",
		"check:pages": "node scripts/build-pages.mjs --check",
		"check:sw": "node scripts/build-service-worker.mjs --check",
		"check:e2e-types": "tsc --noEmit -p Tests/E2E",
		"release": "gulp release",
		"release:web": "gulp release-web"
	},
	"pre-commit": [
		"test:functions",
		"lint:fix"
	],
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node",
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/Tests/E2E/"
		],
		"collectCoverageFrom": [
			"Src/Scripts/**/*.ts",
			"!Src/Scripts/Datasets/**",
			"!Src/Scripts/Main.ts"
		],
		"coverageReporters": [
			"text-summary",
			"lcov"
		],
		"coverageThreshold": {
			"global": {
				"statements": 49,
				"branches": 66,
				"functions": 51,
				"lines": 49
			}
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Oscar-97/VIVA-Benchmark-Data-Analysis.git"
	},
	"author": "Oscar Härtull",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/Oscar-97/VIVA-Benchmark-Data-Analysis/issues"
	},
	"homepage": "https://github.com/Oscar-97/VIVA-Benchmark-Data-Analysis#readme",
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@types/bootstrap": "^5.2.11",
		"@types/jest": "^30.0.0",
		"@types/jquery": "^4.0.1",
		"css-loader": "^7.1.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-html": "^8.2.1",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.13.0",
		"gulp": "^5.0.1",
		"gulp-file": "^0.4.0",
		"gulp-replace": "^1.1.4",
		"gulp-zip": "^6.1.0",
		"jest": "^30.3.0",
		"mathjs": "^15.2.0",
		"merge-stream": "^2.0.0",
		"mini-css-extract-plugin": "^2.10.2",
		"pre-commit": "^1.2.2",
		"prettier": "^3.9.10",
		"source-map-loader": "^5.0.0",
		"ts-jest": "^29.4.9",
		"ts-loader": "^9.5.7",
		"typedoc": "^0.28.20",
		"typedoc-material-theme": "^1.4.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"webpack": ">=5.112.0",
		"webpack-cli": "^7.0.2",
		"webpack-dev-server": "^5.2.3"
	},
	"dependencies": {
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.2",
		"chart.js": "^4.5.1",
		"chartjs-plugin-annotation": "^3.1.0",
		"chartjs-plugin-zoom": "^2.2.0",
		"datatables.net-bs5": "^3.1.4",
		"datatables.net-buttons-bs5": "^4.1.2",
		"datatables.net-datetime": "^2.1.2",
		"datatables.net-fixedcolumns-bs5": "^6.1.1",
		"datatables.net-responsive-bs5": "^4.1.1",
		"datatables.net-searchbuilder-bs5": "^2.1.1",
		"datatables.net-searchpanes-bs5": "^3.0.0",
		"datatables.net-select-bs5": "^4.1.1",
		"jquery": "^4.0.0"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	}
}
