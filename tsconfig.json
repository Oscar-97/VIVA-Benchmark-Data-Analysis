{
  "compilerOptions": {
    "outDir": "./Built",
    "rootDir": "./Src/.",
    "allowJs": true,
    "target": "esnext",
    "module": "es2020",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["jest"],
    "removeComments": false
  },
  "include": ["./Src/**/*"],
  "exclude": ["**/node_modules/**"]
}
