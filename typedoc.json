{
  "entryPoints": ["Src/Scripts"],
  "entryPointStrategy": "expand",
  "exclude": ["**/*.d.ts", "**/Datasets/**"],
  "out": "Docs",
  "cleanOutputDir": false,
  "categorizeByGroup": true,
  "name": "System Documentation",
  "readme": "Src/Docs/README.md",
  "highlightLanguages": ["bash", "console", "css", "csv", "html", "javascript", "json", "jsonc", "text", "tsx", "typescript"],
  "projectDocuments": ["Src/Docs/USER_GUIDE.md"],
  "plugin": ["typedoc-material-theme"],
  "themeColor": "#cb9820",
}
